{
  "version": "1.0",
  "model": {
    "provider": "custom",
    "name": "deepseek-v4-flash",
    "baseURL": "https://api.deepseek.com",
    "apiKey": "${DEEPSEEK_API_KEY}"
  },
  "channels": {
    "feishu": {
      "enabled": false,
      "appId": "${FEISHU_APP_ID}",
      "appSecret": "${FEISHU_APP_SECRET}",
      "port": 3000
    }
  },
  "agents": {
    "maxSpawnDepth": 1,
    "maxConcurrent": 3,
    "defaultTimeout": 60000
  },
  "memory": {
    "dataDir": "."
  },
  "rag": {
    "enabled": true,
    "docsDir": "docs"
  },
  "cron": {
    "enabled": true,
    "dataDir": "."
  },
  "session": {
    "id": "default"
  }
}
